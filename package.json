  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "clean": "rm -rf .next out build .turbo coverage .vercel .netlify .wrangler && find . -name '.DS_Store' -type f -delete 2>/dev/null; find . -name '*.tsbuildinfo' -type f -delete 2>/dev/null; exit 0",
    "clean:all": "npm run clean && rm -rf node_modules"
  },
